# Backend / S3 Storage (Cloudflare R2 / Supabase)
PORT=8080
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key
STORAGE_BUCKET_NAME=prism-blobs

# Blockchain (Base Sepolia / Polygon Amoy)[cite: 1]
RPC_URL=https://sepolia.base.org
WALLET_PRIVATE_KEY=0x_your_private_key_here
CONTRACT_ADDRESS=0x_deployed_contract_address_here

# AI & LLM Inference[cite: 1]
GEMINI_API_KEY=your_gemini_api_key_here